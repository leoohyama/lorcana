```{r}
#| context: setup
#| include: false
# ==========================================
# 1. THE CHEF: R Data Processing (Runs Once)
# ==========================================
library(tidyverse)
library(DBI)
library(RPostgres)

# Load Dictionary & Fix Image Paths
master_dict <- read_csv("data/target_cards_with_epids2.csv", show_col_types = FALSE) %>%
  mutate(
    id = as.character(id), 
    tcgplayer_id = as.integer(tcgplayer_id), 
    cardname = paste(name, replace_na(version, ""), rarity, sep = " - "),
    folder_name = str_replace_all(set_name, "[ ']", "_"),
    image_path = paste0("data/enchanteds/images/", folder_name, "/", id, ".avif")
  ) %>%
  distinct(id, .keep_all = TRUE)

# Connect to Neon
con <- dbConnect(RPostgres::Postgres(), host = "ep-frosty-unit-amykrca9.c-5.us-east-1.aws.neon.tech", dbname = "neondb", user = "neondb_owner", password = Sys.getenv("NEON_PASSWORD"), port = 5432, sslmode = "require")

# Fetch Core Data
latest_prices <- dbGetQuery(con, "SELECT DISTINCT ON (tcgplayer_id) tcgplayer_id, market_price, pull_date FROM justtcg_prices ORDER BY tcgplayer_id, pull_date DESC")
past_prices <- dbGetQuery(con, "SELECT DISTINCT ON (tcgplayer_id) tcgplayer_id, market_price, pull_date FROM justtcg_prices WHERE pull_date <= CURRENT_DATE - INTERVAL '7 days' ORDER BY tcgplayer_id, pull_date DESC")
hist_data <- dbGetQuery(con, "SELECT tcgplayer_id, pull_date, market_price FROM justtcg_prices WHERE pull_date >= CURRENT_DATE - INTERVAL '365 days'")
chronos_pred <- dbGetQuery(con, "SELECT card_id as tcgplayer_id, target_date, pred_price, conf_low, conf_high, run_id FROM chronos_predictions")
gru_pred <- dbGetQuery(con, "SELECT card_id as tcgplayer_id, target_date, pred_price, run_id FROM gru_predictions")
metrics_df <- tryCatch(dbGetQuery(con, "SELECT tcgplayer_id, samp_ent_30d, hurst_30d, cv_30d, skewness_30d FROM card_ts_metrics"), error = function(e) data.frame())

# --- Fetch NEW eBay Data using SQL Join to save RAM ---
ebay_query <- "
  SELECT 
    a.item_id, a.price_val, a.listing_type, a.date_pulled,
    l.id, l.grading_company, l.grade_val
  FROM lorcana_active_listings a
  INNER JOIN llm_listing_metadata l ON a.item_id = l.item_id
  WHERE (l.is_valid = 'TRUE' OR l.is_valid = true)
    AND a.price_val IS NOT NULL 
    AND a.price_val > 0
"
raw_ebay_sql <- tryCatch(dbGetQuery(con, ebay_query), error = function(e) data.frame())

dbDisconnect(con)

# --- Process Momentum ---
momentum <- latest_prices %>% 
  inner_join(past_prices, by = "tcgplayer_id", suffix = c("_cur", "_past")) %>% 
  mutate(pct = (market_price_cur - market_price_past)/market_price_past * 100, abs = market_price_cur - market_price_past) %>% 
  left_join(master_dict, by = "tcgplayer_id") %>% drop_na(cardname)

if(nrow(momentum) > 0) {
  top_pct_g <- momentum %>% arrange(desc(pct)) %>% slice(1) %>% mutate(Category = "Top % Gainer")
  top_pct_l <- momentum %>% arrange(pct) %>% slice(1) %>% mutate(Category = "Top % Loser")
  top_abs_g <- momentum %>% arrange(desc(abs)) %>% slice(1) %>% mutate(Category = "Top $ Gainer")
  top_abs_l <- momentum %>% arrange(abs) %>% slice(1) %>% mutate(Category = "Top $ Loser")
  movers <- bind_rows(top_pct_g, top_pct_l, top_abs_g, top_abs_l)
} else {
  movers <- data.frame()
}

# --- Process Forecasts for Plotting ---
max_c_run <- if(nrow(chronos_pred) > 0) max(chronos_pred$run_id, na.rm=TRUE) else 0
max_g_run <- if(nrow(gru_pred) > 0) max(gru_pred$run_id, na.rm=TRUE) else 0

forecast_flat <- bind_rows(
  chronos_pred %>% mutate(tcgplayer_id = as.integer(tcgplayer_id)) %>% left_join(master_dict, by = "tcgplayer_id") %>% mutate(model = "Chronos", is_shadow = ifelse(run_id == max_c_run, FALSE, TRUE)) %>% select(cardname, date = target_date, model, price = pred_price, conf_low, conf_high, is_shadow, run_id),
  gru_pred %>% mutate(tcgplayer_id = as.integer(tcgplayer_id)) %>% left_join(master_dict, by = "tcgplayer_id") %>% mutate(model = "GRU", is_shadow = ifelse(run_id == max_g_run, FALSE, TRUE), conf_low = NA, conf_high = NA) %>% select(cardname, date = target_date, model, price = pred_price, conf_low, conf_high, is_shadow, run_id)
) %>% mutate(date = as.character(date)) %>% drop_na(cardname)

hist_flat <- hist_data %>% left_join(master_dict, by = "tcgplayer_id") %>% select(cardname, date = pull_date, price = market_price) %>% mutate(date = as.character(date)) %>% drop_na(cardname)

# --- Process Deeper Dive Data ---
if(nrow(metrics_df) > 0) metrics_df$tcgplayer_id <- as.integer(metrics_df$tcgplayer_id)
unified <- master_dict %>% 
  left_join(latest_prices %>% rename(current_price = market_price), by="tcgplayer_id") %>%
  left_join(metrics_df, by="tcgplayer_id")

# --- Process NEW eBay Listings Data ---
if(nrow(raw_ebay_sql) > 0) {
  ebay_master <- raw_ebay_sql %>%
    mutate(id = as.character(id)) %>%
    left_join(master_dict, by = "id") %>%
    mutate(
      type_simple = if_else(str_detect(listing_type, regex("AUCTION", ignore_case = TRUE)), "Auction", "Buy It Now"),
      grade_val = replace_na(as.character(grade_val), "Raw"),
      grading_company = replace_na(as.character(grading_company), "Raw"),
      date_pulled = as.character(date_pulled) 
    ) %>%
    select(item_id, cardname, date_pulled, price_val, grading_company, grade_val, type_simple) %>%
    drop_na(cardname)
} else {
  ebay_master <- data.frame(item_id=character(), cardname=character(), date_pulled=character(), price_val=numeric(), grading_company=character(), grade_val=character(), type_simple=character())
}

# --- Find the Most Expensive Card ---
top_card <- unified %>% 
  drop_na(current_price) %>% 
  arrange(desc(current_price)) %>% 
  slice(1) %>% 
  pull(cardname)

if(length(top_card) == 0) top_card <- "Stitch - Carefree Surfer - Enchanted"

# Transfer to JavaScript
ojs_define(
  ojs_movers = movers,
  ojs_hist = hist_flat,
  ojs_forecast = forecast_flat,
  ojs_info = unified,
  ojs_ebay = ebay_master,
  ojs_cards = sort(unique(master_dict$cardname)),
  ojs_default_card = top_card
)
```

```{=html}
<style>
  @import url('[https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap](https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap)');

  :root {
    --bg-base: #0f172a;       
    --bg-card: #1e293b;       
    --bg-hover: #334155;      
    --border-subtle: #475569; 
    
    --text-main: #f8fafc;     
    --text-muted: #94a3b8;    
    
    --accent-blue: #38bdf8;   
    --accent-cyan: #22d3ee;   
    --accent-yellow: #fbbf24; 
    --accent-red: #f87171;    
    --accent-green: #34d399;  
  }

  body, .dashboard-container, text, th, td, div {
    font-family: 'Inter', sans-serif !important;
  }

  .momentum-box { 
    background: linear-gradient(135deg, var(--bg-card), var(--bg-base)); 
    border-left: 5px solid var(--accent-blue); 
    padding: 18px 22px; 
    border-radius: 12px; 
    margin-bottom: 25px; 
    color: var(--text-main); 
    font-size: 15px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  }
  
  .green-text { color: var(--accent-green); font-weight: 700; }
  .red-text { color: var(--accent-red); font-weight: 700; }
  
  .flip-card { perspective: 1000px; cursor: pointer; }
  .flip-card-inner { position: relative; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1); transform-style: preserve-3d; }
  .flip-card-inner.is-flipped { transform: rotateY(180deg); }
  .flip-card-front, .flip-card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 12px; }
  .flip-card-back { transform: rotateY(180deg); background-color: var(--bg-base); border: 2px solid var(--accent-blue); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding: 15px 10px; text-align: center; }

  g[aria-label="tip"] path { fill: var(--bg-card) !important; stroke: var(--accent-blue) !important; stroke-width: 2px !important; fill-opacity: 0.95 !important; }
  g[aria-label="tip"] text { fill: var(--text-main) !important; font-size: 14px !important; font-weight: 600 !important; stroke: none !important; }

  .hover-table { width: 100%; border-collapse: separate; border-spacing: 0; color: var(--text-main); font-size: 14px; text-align: left; }
  .hover-table th { background-color: var(--bg-card); padding: 14px 12px; border-bottom: 2px solid var(--accent-blue); position: sticky; top: 0; z-index: 10; transition: background 0.2s; user-select: none; white-space: nowrap; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 12px;}
  .hover-table th:hover { background-color: var(--bg-hover); }
  .hover-table td { padding: 12px; border-bottom: 1px solid var(--border-subtle); vertical-align: middle; white-space: nowrap; }
  .hover-table tbody tr { transition: background-color 0.2s; cursor: pointer; background-color: var(--bg-base); }
  .hover-table tbody tr:hover { background-color: var(--bg-hover); }
  
  .hover-table th.sticky-card-col, .hover-table td.sticky-card-col { position: sticky; left: 0; z-index: 5; background-color: inherit; border-right: 1px solid var(--border-subtle); box-shadow: 4px 0 8px rgba(0,0,0,0.2); }
  .hover-table thead th.sticky-card-col { z-index: 15; background-color: var(--bg-card); }
  
  .modal-overlay { display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px); align-items: center; justify-content: center; }
  .modal-content { background-color: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 16px; width: 95%; max-width: 1200px; padding: 24px; position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); max-height: 90vh; overflow-y: auto; }
  .close-btn { color: var(--text-muted); position: absolute; top: 12px; right: 24px; font-size: 32px; font-weight: bold; cursor: pointer; transition: 0.2s; z-index: 99; }
  .close-btn:hover { color: var(--accent-red); }
</style>
```

# Market Overview {orientation="rows"}

::: {.callout-note appearance="minimal" icon="false"}
## 📈 Understanding the Market Metrics
* **7-Day Changes:** All percentage shifts and momentum categories represent a **7-day rolling window**. This captures actual weekly momentum rather than noisy day-to-day spikes.
:::

## Row {.flow}

```{ojs}
//| output: false
movers_data = transpose(ojs_movers)
```

```{ojs}
market_overview_node = {
  const top_div = document.createElement("div");
  top_div.style.width = "100%";
  top_div.style.maxWidth = "1200px";
  top_div.style.margin = "0 auto";
  
  const container = document.createElement("div");
  container.style.display = "flex";
  container.style.justifyContent = "space-around";
  container.style.background = "var(--bg-card)";
  container.style.padding = "25px 10px";
  container.style.borderRadius = "12px";
  container.style.flexWrap = "wrap";
  container.style.boxShadow = "0 4px 6px -1px rgba(0,0,0,0.3)";
  
  if (movers_data.length === 0) {
    container.innerHTML = "<div style='color:var(--text-muted);'>Not enough recent market movement to calculate momentum.</div>";
  } else {
    const all_hist = transpose(ojs_hist).map(d => ({ ...d, date: new Date(d.date) }));
    
    movers_data.forEach(row => {
      let p_c = row.pct >= 0 ? "green-text" : "red-text";
      let sign = row.abs >= 0 ? "+" : "";
      
      const wrapper = document.createElement("div");
      wrapper.style.display = "flex";
      wrapper.style.flexDirection = "column";
      wrapper.style.alignItems = "center";
      wrapper.style.width = "260px";
      wrapper.style.textAlign = "center";
      wrapper.style.margin = "10px";
      
      wrapper.innerHTML = `
        <div class="flip-card" onclick="this.querySelector('.flip-card-inner').classList.toggle('is-flipped');" style="width: 260px; height: 380px;">
          <div class="flip-card-inner">
            <div class="flip-card-front" style="background-color: var(--bg-base); border: 1px solid var(--border-subtle); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 15px 10px;">
              <div style="font-size: 20px; font-weight: 500; color: var(--accent-blue); text-transform: uppercase; margin-bottom: 15px; letter-spacing: 1px;">${row.Category}</div>
              <img src="${row.image_path}" style="height: 210px; border-radius: 6px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.5);">
              <div style="margin-top: 15px; font-size: 14px; font-weight: 600; color: var(--text-main); height: 36px; line-height: 1.3;">${row.cardname}</div>
              <div style="margin-top: 8px; font-size: 18px; font-weight: 800; color: var(--accent-yellow);">$${row.market_price_cur.toFixed(2)}</div>
              <div class="${p_c}" style="font-size: 14px; margin-top: 4px;">${sign}$${row.abs.toFixed(2)} (${row.pct.toFixed(1)}%)</div>
            </div>
            <div class="flip-card-back" id="back-${row.tcgplayer_id}">
              <span style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px; margin-bottom: 15px; font-weight: 700; font-size: 16px; color: var(--accent-blue);">${row.Category}</span>
              <span style="font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Current Price</span>
              <span style="font-size: 28px; font-weight: 800; color: var(--accent-yellow); margin-bottom: 20px;">$${row.market_price_cur.toFixed(2)}</span>
              <span style="font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px;">7-Day Trend</span>
            </div>
          </div>
        </div>
      `;
      
      const card_hist = all_hist
         .filter(d => d.cardname === row.cardname)
         .filter(d => d.date >= new Date(Date.now() - 7 * 24 * 60 * 60 * 1000))
         .sort((a, b) => a.date - b.date); 
         
      const sparkline = Plot.plot({
        height: 120,
        width: 220,
        style: { background: "transparent", fontFamily: "Inter" },
        x: { axis: null },
        y: { axis: null },
        marks: [
          Plot.lineY(card_hist, {x: "date", y: "price", stroke: "var(--accent-blue)", strokeWidth: 3}),
          Plot.dot(card_hist.slice(-1), { x: "date", y: "price", fill: "var(--accent-yellow)", r: 5 })
        ]
      });

      wrapper.querySelector(`#back-${row.tcgplayer_id}`).appendChild(sparkline);
      container.appendChild(wrapper);
    });
  }
  
  top_div.appendChild(container);
  return top_div; 
}
```

