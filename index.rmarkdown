## Column
::: {.callout-note appearance="minimal" icon="false"}
## 🔍 eBay Market Explorer
**Buy It Now** listings represent fixed-price market inventory (with daily medians), while **Auctions** are grouped by `item_id` to show exactly how bidding wars evolve over time. Use the interactive legend below the charts to toggle specific grades on or off!
:::

```{ojs}
//| title: "Interactive Listing Tracker"
//| padding: 0px

// 1. Data Preparation & Label Generation
raw_ebay = transpose(ojs_ebay).map(d => {
  let grade = d.grade_val || "Raw";
  let comp = d.grading_company || "Raw";
  let label = comp === 'Raw' ? 'Raw' : `${comp} ${grade}`;
  return {
    ...d,
    clean_price: +d.price_val,
    label: label,
    hover_text: `<b>${d.cardname}</b><br>${label}<br>$${d.price_val}<br>Date: ${d.date_pulled}`
  };
}).filter(d => !isNaN(d.clean_price) && d.clean_price > 0)

// 2. Apply Filters
filtered_ebay = raw_ebay.filter(d => 
  (d.cardname === ebay_selected_card) &&
  (ebay_selected_company === "All" || d.grading_company === ebay_selected_company) &&
  (ebay_selected_grades.includes(d.grade_val || "Raw"))
)

// 3. Dynamic Color Mapping
unique_labels = [...new Set(filtered_ebay.map(d => d.label))].sort()
color_palette = ['#38bdf8', '#fbbf24', '#34d399', '#f87171', '#a78bfa', '#fb923c', '#60a5fa', '#f472b6', '#2dd4bf', '#a3e635']

color_map = {
  let local_map = {};
  unique_labels.forEach((lbl, i) => {
    local_map[lbl] = color_palette[i % color_palette.length];
  });
  return local_map;
}

// ==========================================
// --- BUY IT NOW PLOT ---
// ==========================================
bin_plot_node = {
  const div = document.createElement("div");
  div.style.height = "450px"; 
  div.style.marginBottom = "20px";
  
  const bin_data = filtered_ebay.filter(d => d.type_simple === "Buy It Now");
  
  if(bin_data.length === 0) {
    div.innerHTML = "<div style='padding:50px; text-align:center; color:#94a3b8; background:transparent; border-radius:12px;'>No Buy It Now data available for your current filters.</div>";
    return div;
  }
  
  let traces = [];
  unique_labels.forEach(lbl => {
    let subset = bin_data.filter(d => d.label === lbl).sort((a,b) => new Date(a.date_pulled) - new Date(b.date_pulled));
    if(subset.length === 0) return;
    
    traces.push({
      x: subset.map(d => d.date_pulled), y: subset.map(d => d.clean_price),
      mode: 'markers', name: lbl, legendgroup: lbl,
      marker: {color: color_map[lbl], size: 6, opacity: 0.4, line: {width: 1, color: '#0f172a'}},
      text: subset.map(d => d.hover_text), hoverinfo: 'text'
    });
    
    let grouped = {};
    subset.forEach(d => { if(!grouped[d.date_pulled]) grouped[d.date_pulled] = []; grouped[d.date_pulled].push(d.clean_price); });
    let meds = Object.keys(grouped).map(date => {
      let prices = grouped[date].sort((a,b)=>a-b);
      let mid = Math.floor(prices.length/2);
      let med = prices.length%2!==0 ? prices[mid] : (prices[mid-1]+prices[mid])/2;
      return {date: date, med: med};
    }).sort((a,b) => new Date(a.date) - new Date(b.date));
    
    traces.push({
      x: meds.map(d => d.date), y: meds.map(d => d.med),
      mode: 'lines', name: lbl + ' Median', legendgroup: lbl, showlegend: false,
      line: {color: color_map[lbl], width: 4}, hoverinfo: 'skip'
    });
  });
  
  Plotly.newPlot(div, traces, {
     title: {text: 'Buy It Now: Daily Medians & Active Inventory', font: {color: '#f8fafc', family: 'Inter'}, x: 0.05},
     paper_bgcolor: 'transparent', plot_bgcolor: 'transparent', font: {color: '#f8fafc', family:'Inter'},
     xaxis: {gridcolor: '#334155', tickformat: '%b %d'}, 
     yaxis: {gridcolor: '#334155', tickprefix: '$'},
     margin: {l:60, r:20, t:50, b:40}, hovermode: 'closest',
     legend: { orientation: 'h', y: -0.2, x: 0.5, xanchor: 'center' }
  }, {responsive: true, displayModeBar: false});
  
  return div;
}

// ==========================================
// --- AUCTION TRAJECTORY PLOT ---
// ==========================================
auc_plot_node = {
  const div = document.createElement("div");
  div.style.height = "450px";
  
  const auc_data = filtered_ebay.filter(d => d.type_simple === "Auction");
  
  if(auc_data.length === 0) {
    div.innerHTML = "<div style='padding:50px; text-align:center; color:#94a3b8; background:transparent; border-radius:12px;'>No active Auctions available for your current filters.</div>";
    return div;
  }
  
  let traces = [];
  unique_labels.forEach(lbl => {
    let subset = auc_data.filter(d => d.label === lbl);
    if(subset.length === 0) return;
    
    let item_ids = [...new Set(subset.map(d => d.item_id))];
    
    item_ids.forEach((iid, idx) => {
       let item_data = subset.filter(d => d.item_id === iid).sort((a,b) => new Date(a.date_pulled) - new Date(b.date_pulled));
       traces.push({
         x: item_data.map(d => d.date_pulled), y: item_data.map(d => d.clean_price),
         mode: 'lines+markers', name: lbl, legendgroup: lbl, 
         showlegend: idx === 0, 
         line: {color: color_map[lbl], width: 2}, marker: {size: 5, color: color_map[lbl]},
         text: item_data.map(d => d.hover_text), hoverinfo: 'text'
       });
    });
  });
  
  Plotly.newPlot(div, traces, {
     title: {text: 'Auction Trajectories (Grouped by Listing ID)', font: {color: '#f8fafc', family: 'Inter'}, x: 0.05},
     paper_bgcolor: 'transparent', plot_bgcolor: 'transparent', font: {color: '#f8fafc', family:'Inter'},
     xaxis: {gridcolor: '#334155', tickformat: '%b %d'}, 
     yaxis: {gridcolor: '#334155', tickprefix: '$'},
     margin: {l:60, r:20, t:50, b:40}, hovermode: 'closest',
     legend: { orientation: 'h', y: -0.2, x: 0.5, xanchor: 'center' }
  }, {responsive: true, displayModeBar: false});
  
  return div;
}
```

