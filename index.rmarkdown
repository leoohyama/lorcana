    <div style="display: flex; justify-content: space-between;"><span style="color:var(--text-muted);">Hurst Exp: </span> <span style="font-family: monospace;">${my_info.hurst_30d ? my_info.hurst_30d.toFixed(3) : "N/A"}</span></div>
